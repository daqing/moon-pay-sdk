///|
let spki_pem : String =
  #|-----BEGIN PUBLIC KEY-----
  #|MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAl8xnVOqaYUGrkSmqv4bu
  #|iDrSwvechdJn5FoxFLaNj8lIYT3au1D4Y5Jt6Pbv1Q5A3xHxQb0cKpqfq9IW7xQm
  #|eBcccW9+wdQRw96lIagV++TM8OCNgNKhXgjH4ewKdGvv6R0QzFymb0O7puC5n6sp
  #|fYKC7D3gxXhJ6ZCC0G2H4x5h+mebjYggsuLtUoXHH/9a11ZzGg7KJV0lye+kyiaV
  #|saPYOdoYVGlvYbxemsd/yUOPPQ2z3534PlUqANh+X00elon4Cyf9clxJ8muhySho
  #|1kMScS2hbWb2ltQgJR74rCgzR2BBgElD4r/7QjNFg91/QhaLkZn3x6eKDjjNniLD
  #|6wIDAQAB
  #|-----END PUBLIC KEY-----

///|
test "pkcs8 private key loads and signs" {
  let key = @crypto.load_private_key_pem(pkcs8_pem)
  let sig = key.sign(b"payload"[:])
  assert_eq(sig.length(), 256)
  assert_true(key.public().verify(b"payload"[:], sig[:]))
}

///|
test "pkcs1 private key loads and signs" {
  let key = @crypto.load_private_key_pem(pkcs1_pem)
  let sig = key.sign(b"payload"[:])
  assert_true(key.public().verify(b"payload"[:], sig[:]))
}

///|
test "public key pem verifies a private-key signature" {
  let pub_key = @crypto.load_public_key_pem(spki_pem)
  let key = @crypto.load_private_key_pem(pkcs8_pem)
  let sig = key.sign(b"payload"[:])
  assert_true(pub_key.verify(b"payload"[:], sig[:]))
}

///|
test "malformed pem is rejected without crashing" {
  let r = try? @crypto.load_private_key_pem("hello")
  assert_true(
    match r {
      Err(@crypto.Malformed(_)) => true
      _ => false
    },
  )
}

///|
test "valid armor with junk body is rejected" {
  let junk = "-----BEGIN PRIVATE KEY-----\n!!!not base64!!!\n-----END PRIVATE KEY-----"
  let r = try? @crypto.load_private_key_pem(junk)
  assert_true(
    match r {
      Err(@crypto.Malformed(_)) => true
      _ => false
    },
  )
}

///|
test "a public key is not a private key" {
  let r = try? @crypto.load_private_key_pem(spki_pem)
  assert_true(
    match r {
      Err(@crypto.Malformed(_)) => true
      _ => false
    },
  )
}
